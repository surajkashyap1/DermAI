# Copy to .env and fill in as needed. Everything is optional — the app runs
# without configuration (chat uses an offline extractive fallback).

# Groq free-tier API key enables grounded LLM chat (get one at https://console.groq.com).
GROQ_API_KEY=

# Web frontend (apps/web) -> URL of the deployed FastAPI backend.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Optional overrides
DERMAI_GROQ_MODEL=openai/gpt-oss-20b
DERMAI_GROQ_TEMPERATURE=0.2
DERMAI_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
DERMAI_RETRIEVER_TOP_K=4
# DERMAI_MODEL_PATH=models/best_model.h5
# DERMAI_FAISS_INDEX_DIR=faiss_index
